<!-- QuickPane.Tests.csproj
     Purpose: the NUnit test project for QuickPane (SDK-style, net48, x64).
     Reason: dotnet test runs these tests against the QuickPane.exe that MSBuild builds.
     Defines: the QuickPane.Tests assembly.
     Origin: from jprisant's fork, commit 7821277 (MIT, see NOTICE.md).
     Doc: docs/notes/tests/QuickPane.Tests/QuickPane.Tests.csproj.md -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The app is a legacy WPF csproj the .NET SDK cannot build. The tests reference the exe that
         MSBuild builds, with no ProjectReference, and the app is built first. -->
    <Reference Include="QuickPane">
      <HintPath>..\..\QuickPane\bin\x64\$(Configuration)\QuickPane.exe</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
</Project>
